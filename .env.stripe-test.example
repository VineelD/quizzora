# Stripe TEST mode - copy from .env.stripe-test.local after running: npm run stripe:sandbox
# Get a Stripe test secret key from https://dashboard.stripe.com/test/apikeys
#
# STRIPE_TEST_SECRET_KEY=replace-with-your-stripe-test-secret-key
#
# Then generated output (example shape only):
# STRIPE_SECRET_KEY=replace-with-generated-test-secret-key
# STRIPE_WEBHOOK_SECRET=replace-with-generated-test-webhook-secret
# STRIPE_PRICE_MONTHLY=replace-with-generated-monthly-price-id
# STRIPE_PRICE_YEARLY=replace-with-generated-yearly-price-id
# STRIPE_PRICE_FAMILY_MONTHLY=replace-with-generated-family-monthly-price-id
# STRIPE_PRICE_FAMILY_YEARLY=replace-with-generated-family-yearly-price-id
# BILLING_DISPLAY_MONTHLY_AUD=120
# BILLING_DISPLAY_YEARLY_AUD=1200
# BILLING_DISPLAY_FAMILY_MONTHLY_AUD=30
# BILLING_DISPLAY_FAMILY_YEARLY_AUD=300
# BILLING_TRIAL_DAYS=7
