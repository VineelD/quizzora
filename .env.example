# Required in production - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-me

# Public URL users open in the browser (used in verification emails)
APP_BASE_URL=https://quizzora.org

# Operator details - product brand vs legal operator (sole trader)
OPERATOR_PRODUCT_NAME=Quizzora
OPERATOR_LEGAL_NAME=Mr Vineel Davuluri
OPERATOR_ABN=41 833 153 799
OPERATOR_CONTACT_EMAIL=support@quizzora.org

# Optional: automate Cloudflare Email Routing (support@quizzora.org -> your inbox)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# EMAIL_FORWARD_TO=you@gmail.com
# Staging subdomain inbox - see docs/STAGING-EMAIL.md
# EMAIL_ROUTING_DOMAIN=staging.quizzora.org
# EMAIL_ROUTING_LOCAL=inbox

# false = allow session cookies on http (local testing only)
# omit or any other value = Secure cookies only when the request is HTTPS
# AUTH_COOKIE_SECURE=false

# Allow registering a brand-new school (first user becomes admin)
ALLOW_SCHOOL_SIGNUP=true

# Allow teachers to self-register with a school join code from /admin
ALLOW_TEACHER_JOIN=true

# Allow registering a brand-new family (first parent becomes family administrator)
ALLOW_FAMILY_SIGNUP=true

# Allow additional parents to self-register with a family join code
ALLOW_PARENT_JOIN=true

# Family billing caps (optional overrides)
# BILLING_FAMILY_TRIAL_MAX_PARENTS=2
# BILLING_FAMILY_TRIAL_MAX_STUDENTS=6
# BILLING_FAMILY_TRIAL_MAX_AI_QUIZZES=10
# BILLING_FAMILY_PAID_MAX_PARENTS=4
# BILLING_FAMILY_PAID_MAX_STUDENTS=8
# BILLING_FAMILY_PAID_MAX_AI_QUIZZES=30
# BILLING_FAMILY_PAID_MAX_QUESTIONS_PER_QUIZ=30
# Per-student Study Coach cap per assignment (N siblings = N × cap; see docs/FAMILY-PLAN-ECONOMICS.md)
# BILLING_FAMILY_STUDY_MAX_MESSAGES=45
# BILLING_SCHOOL_STUDY_MAX_MESSAGES=40
# BILLING_DISPLAY_FAMILY_MONTHLY_AUD=30
# BILLING_DISPLAY_FAMILY_YEARLY_AUD=300
# STRIPE_PRICE_FAMILY_MONTHLY=replace-with-family-monthly-price-id
# STRIPE_PRICE_FAMILY_YEARLY=replace-with-family-yearly-price-id

# --- Billing (Stripe) - per school subscription ---
# IMPORTANT: This file MUST NOT contain real production secrets.
# Configure real values in `.env.local` (and keep it out of git).
RESEND_API_KEY=replace-with-your-resend-api-key
MAIL_FROM=Quizzora <noreply@quizzora.org>
STRIPE_SECRET_KEY=replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=replace-with-your-webhook-signing-secret
STRIPE_PRICE_MONTHLY=replace-with-monthly-price-id
STRIPE_PRICE_YEARLY=replace-with-yearly-price-id
BILLING_TRIAL_DAYS=7
BILLING_YEARLY_DISCOUNT_PERCENT=17
# BILLING_DISPLAY_MONTHLY_AUD=99
# BILLING_DISPLAY_YEARLY_AUD=1200
#
# Plan limits (0 = unlimited for that cap)
BILLING_TRIAL_MAX_TEACHERS=3
BILLING_TRIAL_MAX_STUDENTS=50
BILLING_TRIAL_MAX_AI_QUIZZES=15
BILLING_PAID_MAX_TEACHERS=25
BILLING_PAID_MAX_STUDENTS=2000
BILLING_PAID_MAX_AI_QUIZZES=0

# SQLite path (optional; default is ./data/littlecode.sqlite)
SQLITE_DATABASE_PATH=C:\LittleCode\data\littlecode.sqlite

# --- Email (pick ONE provider) ---

# Option A: Resend (recommended for home hosting)
# 1. Sign up at https://resend.com
# 2. Add domain quizzora.org and DNS records in Cloudflare (see docs/DNS-QUIZZORA.md)
# 3. Create API key


# Shown in footer and legal pages
DATA_REGION_LABEL=Australia (operator-hosted)

# Option B: SMTP (Outlook personal often blocks this with error 535 5.7.139)
# Personal @outlook.com cannot enable SMTP AUTH - use Resend instead.
# Microsoft 365 only: admin center -> user -> Mail -> Authenticated SMTP = on
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourname@outlook.com
# SMTP_PASS=your-app-password
# MAIL_FROM=LittleCode <yourname@outlook.com>

# Platform super admin (create with: node scripts/create-superadmin.mjs)
# SUPERADMIN_EMAIL=superadmin@your-domain.example
# SUPERADMIN_PASSWORD=
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_NAME=Platform Super Admin

# Support desk (create with: node scripts/create-support.mjs)
# SUPPORT_EMAIL=support@your-domain.example
# SUPPORT_PASSWORD=
# SUPPORT_USERNAME=support
# SUPPORT_NAME=Support Agent

# OpenAI (quiz generation + Study Coach)
# OPENAI_API_KEY=
# OPENAI_ENDPOINT=https://api.openai.com/v1/responses
#
# --- Quiz quality (recommended for production) ---
# Prioritize student clarity over API cost — unlimited diagrams, high image quality, LLM self-review
# QUIZ_QUALITY_FIRST=true
# QUIZ_PREFER_AI_DIAGRAMS=true
# QUIZ_MAX_DIAGRAMS_PER_QUIZ=0
# OPENAI_IMAGE_QUALITY=high
# OPENAI_DIAGRAM_VALIDATE=true
# Cheap second-pass review after generation (set false to skip)
# QUIZ_LLM_SELF_REVIEW=true
# OPENAI_QUIZ_REVIEW_MODEL=gpt-4o-mini
#
# When QUIZ_QUALITY_FIRST=true and QUIZ_MAX_DIAGRAMS_PER_QUIZ is unset, diagram cap is unlimited (0).
# --- Budget / cost control ---
# Quiz generation model (keep on a capable model for teacher quality)
# OPENAI_MODEL=gpt-4.1-mini
# Disable quiz diagram image_generation tool to save ~$0.04â€“0.12 per quiz (text-only questions)
# OPENAI_IMAGE_GENERATION=false
# QUIZ_MAX_DIAGRAMS_PER_QUIZ=4
# OPENAI_IMAGE_QUALITY=low
# OPENAI_IMAGE_SIZE=1024x1024
# Optional cap on quiz JSON output tokens (omit = provider default)
# OPENAI_QUIZ_MAX_OUTPUT_TOKENS=
# Retry policy for transient OpenAI/Cloudflare errors (429, 502, 503, 520)
# OPENAI_RETRY_MAX_ATTEMPTS=3
# OPENAI_RETRY_BASE_DELAY_MS=1000
#
# Study Coach (cheaper model is usually fine for tutoring)
# STUDY_COACH_ENABLED=true
# STUDY_COACH_MODEL=gpt-4o-mini
# STUDY_COACH_MAX_OUTPUT_TOKENS=750
# Study Coach diagram image API model (separate from chat; defaults to STUDY_COACH_MODEL)
# OPENAI_DIAGRAM_MODEL=gpt-4o-mini
# Cache identical diagram prompts in SQLite (set false to always regenerate)
# DIAGRAM_IMAGE_CACHE=true
# STUDY_COACH_DIAGRAMS=true
# Max OpenAI image diagrams per coach reply (visual sequences allow up to 3 when enabled)
# STUDY_COACH_MAX_DIAGRAMS_PER_REPLY=1
# Hard stop for diagram + TTS work per reply (milliseconds)
# STUDY_COACH_MEDIA_BUDGET_MS=45000
# STUDY_COACH_MOCK=false
#
# Topic-focused study time required before quiz unlock (default 30 minutes)
# STUDY_UNLOCK_MIN_SECONDS=1800
# Minimum seconds credited per on-topic message; gaps capped separately
# STUDY_MIN_SECONDS_PER_ON_TOPIC_MESSAGE=45
# STUDY_MAX_GAP_SECONDS=300
# Global fallback; tier overrides below (per student per assignment — N children = N × cap)
# STUDY_MAX_MESSAGES=60
# BILLING_FAMILY_STUDY_MAX_MESSAGES=45
# BILLING_SCHOOL_STUDY_MAX_MESSAGES=40
# Study Coach narration (off by default - zero API cost)
# Browser Web Speech + narration controls in the walkthrough UI:
# STUDY_COACH_NARRATION_ENABLED=true
# Paid OpenAI TTS (pre-generated MP3 per step; legacy alias STUDY_COACH_NARRATION=true):
# STUDY_COACH_TTS_ENABLED=false  # keep paid TTS off (family economics)
# STUDY_COACH_TTS_MODEL=tts-1
# Professional voices: alloy (default), nova, onyx. Avoid cartoonish delivery in prompts.
# STUDY_COACH_TTS_VOICE=alloy
# Slightly slower narration for clarity (0.25â€“4.0, default 0.95)
# STUDY_COACH_TTS_SPEED=0.95
# STUDY_COACH_MAX_NARRATION_PER_REPLY=6
# Study Coach microphone speech input in the Learn tab compose area (default on):
# STUDY_COACH_SPEECH_INPUT_ENABLED=true
# NEXT_PUBLIC_STUDY_COACH_SPEECH_INPUT_ENABLED=true
#
# Math-mode speech refinement via local embeddings (Transformers.js; zero API cost).
# First refine after server restart may take 5-15s while the model loads (CPU).
# STUDY_COACH_SPEECH_ML_REFINE=true
# STUDY_COACH_SPEECH_ML_MODEL=Xenova/all-MiniLM-L6-v2
