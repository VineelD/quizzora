# Stripe TEST mode — copy from .env.stripe-test.local after running: npm run stripe:sandbox
# Get sk_test_... from https://dashboard.stripe.com/test/apikeys
#
# STRIPE_TEST_SECRET_KEY=sk_test_...
#
# Then generated output (example shape only):
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# STRIPE_PRICE_FAMILY_MONTHLY=price_...
# STRIPE_PRICE_FAMILY_YEARLY=price_...
# BILLING_DISPLAY_MONTHLY_AUD=120
# BILLING_DISPLAY_YEARLY_AUD=1200
# BILLING_DISPLAY_FAMILY_MONTHLY_AUD=30
# BILLING_DISPLAY_FAMILY_YEARLY_AUD=300
# BILLING_TRIAL_DAYS=7
