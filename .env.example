# Required in production Ã¢â‚¬â€ generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-long-random-secret

# Public URL users open in the browser (used in verification emails)
APP_BASE_URL=https://quizzora.org

# Maintenance mode â€” set true to show /maintenance to all visitors (health + Stripe webhook still work)
# MAINTENANCE_MODE=true
# Optional operator bypass for /superadmin during maintenance (POST /api/maintenance-bypass with { "secret": "..." })
# MAINTENANCE_BYPASS_SECRET=replace-with-long-random-secret

# Operator details â€” product brand vs legal operator (hobby project)
OPERATOR_PRODUCT_NAME=Quizzora
OPERATOR_LEGAL_NAME=Mr Vineel Davuluri
# Leave unset for hobby operation (no ABN on public pages):
# OPERATOR_ABN=
OPERATOR_CONTACT_EMAIL=support@quizzora.org

# Free access (default true) â€” schools and families use Quizzora without Stripe subscriptions
BILLING_FREE_ACCESS=true
# Optional voluntary donation link (PayPal, Ko-fi, etc.) â€” suggested max shown to users
# DONATION_URL=https://ko-fi.com/your-page
# DONATION_MAX_AUD=10

# Optional: automate Cloudflare Email Routing (support@quizzora.org Ã¢â€ â€™ your inbox)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# EMAIL_FORWARD_TO=you@gmail.com
# Staging subdomain inbox Ã¢â‚¬â€ see docs/STAGING-EMAIL.md
# EMAIL_ROUTING_DOMAIN=staging.quizzora.org
# EMAIL_ROUTING_LOCAL=inbox

# false = allow session cookies on http (local testing only)
# omit or any other value = Secure cookies only when the request is HTTPS
# AUTH_COOKIE_SECURE=false

# Allow registering a brand-new school (first user becomes admin)
ALLOW_SCHOOL_SIGNUP=true

# Allow teachers to self-register with a school join code from /admin
ALLOW_TEACHER_JOIN=true

# Allow registering a brand-new family (first parent becomes family administrator)
ALLOW_FAMILY_SIGNUP=true

# Allow additional parents to self-register with a family join code
ALLOW_PARENT_JOIN=true

# Family billing caps (optional overrides)
# BILLING_FAMILY_TRIAL_MAX_PARENTS=2
# BILLING_FAMILY_TRIAL_MAX_STUDENTS=6
# BILLING_FAMILY_TRIAL_MAX_AI_QUIZZES=10
# BILLING_FAMILY_PAID_MAX_PARENTS=4
# BILLING_FAMILY_PAID_MAX_STUDENTS=8
# BILLING_FAMILY_PAID_MAX_AI_QUIZZES=30
# BILLING_FAMILY_PAID_MAX_QUESTIONS_PER_QUIZ=30
# Per-student Study Coach cap per assignment (N siblings = N Ã— cap; see docs/FAMILY-PLAN-ECONOMICS.md)
# BILLING_FAMILY_STUDY_MAX_MESSAGES=45
# BILLING_SCHOOL_STUDY_MAX_MESSAGES=40
# BILLING_DISPLAY_FAMILY_MONTHLY_AUD=30
# BILLING_DISPLAY_FAMILY_YEARLY_AUD=300
# STRIPE_PRICE_FAMILY_MONTHLY=price_1TfSzH3jQAalYfPZWcoo8x0H
# STRIPE_PRICE_FAMILY_YEARLY=price_1TfSzH3jQAalYfPZjjr7RO21

# --- Billing (Stripe) â€” only when BILLING_FREE_ACCESS=false ---
# IMPORTANT: This file MUST NOT contain real production secrets.
# Configure real values in `.env.local` (and keep it out of git).
RESEND_API_KEY=replace-with-your-resend-api-key
MAIL_FROM=Quizzora <noreply@quizzora.org>
STRIPE_SECRET_KEY=sk_live_replace-with-your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace-with-your-webhook-signing-secret
STRIPE_PRICE_MONTHLY=price_1TfT2q3jQAalYfPZFXgsCump
STRIPE_PRICE_YEARLY=price_1TfT2q3jQAalYfPZqJtvKG7R
BILLING_TRIAL_DAYS=7
BILLING_YEARLY_DISCOUNT_PERCENT=17
# BILLING_DISPLAY_MONTHLY_AUD=99
# BILLING_DISPLAY_YEARLY_AUD=1200
#
# Plan limits (0 = unlimited for that cap)
BILLING_TRIAL_MAX_TEACHERS=3
BILLING_TRIAL_MAX_STUDENTS=50
BILLING_TRIAL_MAX_AI_QUIZZES=15
BILLING_PAID_MAX_TEACHERS=25
BILLING_PAID_MAX_STUDENTS=2000
BILLING_PAID_MAX_AI_QUIZZES=0

# Node bind address â€” production start scripts pass --hostname 127.0.0.1 (do not expose Node directly)
HOSTNAME=127.0.0.1
PORT=3000

# SQLite path (optional; default is ./data/littlecode.sqlite)
SQLITE_DATABASE_PATH=C:\LittleCode\data\littlecode.sqlite

# --- Email (pick ONE provider) ---

# Option A: Resend (recommended for home hosting)
# 1. Sign up at https://resend.com
# 2. Add domain quizzora.org and DNS records in Cloudflare (see docs/DNS-QUIZZORA.md)
# 3. Create API key


# Shown in footer and legal pages
DATA_REGION_LABEL=Australia (operator-hosted)

# Option B: SMTP (Outlook personal often blocks this with error 535 5.7.139)
# Personal @outlook.com cannot enable SMTP AUTH Ã¢â‚¬â€ use Resend instead.
# Microsoft 365 only: admin center Ã¢â€ â€™ user Ã¢â€ â€™ Mail Ã¢â€ â€™ Authenticated SMTP = on
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=yourname@outlook.com
# SMTP_PASS=your-app-password
# MAIL_FROM=LittleCode <yourname@outlook.com>

# --- Uptime email alerts (scripts/uptime-check.mjs; see docs/UPTIME-MONITORING.md) ---
# UPTIME_ALERT_EMAIL=support@quizzora.org
# UPTIME_CHECK_URL=http://127.0.0.1:3000/api/health
# UPTIME_CHECK_URLS=http://127.0.0.1:3000/api/health,https://quizzora.org/api/health
# UPTIME_FAIL_THRESHOLD=2
# UPTIME_ALERT_COOLDOWN_MINUTES=60

# Platform super admin (create with: node scripts/create-superadmin.mjs)
# SUPERADMIN_EMAIL=superadmin@your-domain.example
# SUPERADMIN_PASSWORD=
# SUPERADMIN_USERNAME=superadmin
# SUPERADMIN_NAME=Platform Super Admin

# Support desk (create with: node scripts/create-support.mjs)
# SUPPORT_EMAIL=support@your-domain.example
# SUPPORT_PASSWORD=
# SUPPORT_USERNAME=support
# SUPPORT_NAME=Support Agent

# OpenAI (optional â€” omit when using local question bank + Onyx Study Coach)
# DISABLE_OPENAI=true
# OPENAI_API_KEY=
# OPENAI_ENDPOINT=https://api.openai.com/v1/responses
#
# Quiz provider: openai (default) | question_bank
# When DISABLE_OPENAI=true, quizzes are served from the local SQLite question bank only.
# QUIZ_PROVIDER=question_bank
#
# --- Quiz quality (recommended for production) ---
# Prioritize student clarity â€” diagramPrompt drives OpenAI image_generation for circuits, cells, graphs
# QUIZ_QUALITY_FIRST=true
# false = use SVG diagramSpec/Mermaid for math/circuits; AI images only for cells/apparatus
# QUIZ_PREFER_AI_DIAGRAMS=false
# QUIZ_MAX_DIAGRAMS_PER_QUIZ=0
# OPENAI_IMAGE_GENERATION=true
# OPENAI_IMAGE_QUALITY=medium
# OPENAI_DIAGRAM_VALIDATE=true
# OPENAI_DIAGRAM_MODEL=gpt-4o-mini
# DIAGRAM_IMAGE_CACHE=true
# Cheap second-pass review after generation (set false to skip)
# QUIZ_LLM_SELF_REVIEW=true
# OPENAI_QUIZ_REVIEW_MODEL=gpt-4o-mini
#
# When QUIZ_QUALITY_FIRST=true and QUIZ_MAX_DIAGRAMS_PER_QUIZ is unset, diagram cap is unlimited (0).
# --- Budget / cost control ---
# Quiz generation model (keep on a capable model for teacher quality)
# OPENAI_MODEL=gpt-4.1-mini
# Disable quiz diagram image_generation tool to save ~$0.04Ã¢â‚¬â€œ0.12 per quiz (text-only questions)
# OPENAI_IMAGE_GENERATION=false
# QUIZ_MAX_DIAGRAMS_PER_QUIZ=4
# OPENAI_IMAGE_QUALITY=low
# OPENAI_IMAGE_SIZE=1024x1024
# Optional cap on quiz JSON output tokens (omit = provider default)
# OPENAI_QUIZ_MAX_OUTPUT_TOKENS=
# Retry policy for transient OpenAI/Cloudflare errors (429, 502, 503, 520)
# OPENAI_RETRY_MAX_ATTEMPTS=3
# OPENAI_RETRY_BASE_DELAY_MS=1000
#
# Question bank (batch and/or sync fill for instant local quizzes)
# Teacher quiz creation uses published rows when QUIZ_PROVIDER=question_bank (no OpenAI at request time).
# QUESTION_BANK_FILL_MODE=sync
# batch | sync | hybrid (batch when slots free, sync when slots full; default sync)
# QUESTION_BANK_SYNC_CONCURRENCY=15
# QUESTION_BANK_SYNC_MAX_CONCURRENCY=15
# QUESTION_BANK_WORKER_ENABLED=true
# QUESTION_BANK_TARGET_PER_CELL=60
# QUESTION_BANK_BATCH_CHUNK_SIZE=100
# QUESTION_BANK_BATCH_MODEL=gpt-4.1-mini
# QUESTION_BANK_MAX_CONCURRENT_BATCHES=3
# QUESTION_BANK_MIN_CONCURRENT_BATCHES=2
# QUESTION_BANK_DYNAMIC_CONCURRENCY=true
# QUESTION_BANK_DYNAMIC_MAX_USAGE_PERCENT=60
# QUESTION_BANK_MAX_ENQUEUED_TOKENS=1900000
# QUESTION_BANK_SUBMIT_STAGGER_MS=5000
# QUESTION_BANK_LIMIT_ERROR_BACKOFF_MS=300000
# QUESTION_BANK_SUBMIT_BACKOFF_MS=60000
# QUESTION_BANK_SUBMIT_DELAY_MS=5000
# QUESTION_BANK_ADAPTIVE_CHUNK=true
# QUESTION_BANK_ADAPTIVE_CHUNK_MAX=250
# QUESTION_BANK_ADAPTIVE_STABLE_MS=3600000
# QUESTION_BANK_EST_BATCH_MINUTES=35
# QUESTION_BANK_MAX_OUTPUT_TOKENS=1200
# QUESTION_BANK_POLL_MS=5000
#
# Question bank RAG (local Ollama embeddings + SQLite vector search)
# Run: node scripts/embed-question-bank.mjs
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Local-only embeddings (RAG + question bank); cloud chat does not replace embed
# OLLAMA_EMBED_BASE_URL=http://127.0.0.1:11434
# OLLAMA_EMBED_CONCURRENCY=4
# OLLAMA_EMBED_TIMEOUT_MS=60000
#
# Study Coach (cheaper model is usually fine for tutoring)
# STUDY_COACH_ENABLED=true
# Provider: openai (default) | ollama | local | hybrid | onyx
# When DISABLE_OPENAI=true and STUDY_COACH_PROVIDER is unset, defaults to onyx.
# STUDY_COACH_PROVIDER=onyx
#
# --- Onyx (local Docker deployment for Study Coach chat) ---
# ONYX_API_BASE_URL=http://localhost:3001/api
# ONYX_API_KEY=your-onyx-pat-for-study-coach-chat
# ONYX_INGESTION_API_KEY=your-admin-api-key-for-curriculum-upload-scripts
# ONYX_PERSONA_ID=1
# ONYX_PROJECT_ID=
# Onyx RAG + Ollama tool calls can exceed 2 minutes; keep below IIS ARR proxy (6 min).
# ONYX_CHAT_TIMEOUT_MS=300000
# Narrow RAG to the student's subtopic via internal_search_filters (matches #ONYX_METADATA tags on curriculum files)
# ONYX_SEARCH_FILTER_ENABLED=true
# ONYX_SEARCH_FILTER_MODE=scoped
# scoped (default) | focus_label | subtopic | off
# Optional document set name on the Onyx side (cc_pair 34 bundle)
# ONYX_DOCUMENT_SET=Quizzora Curriculum
# SSE streaming from Onyx for faster time-to-first-token (enable /api/student/study/stream)
# ONYX_STREAM=false
#
# Skip Onyx internal_search when subtopic is scoped â€” inject full curriculum from SQLite instead.
# Saves OpenSearch embed + tool round-trip (~1â€“3 min on CPU Ollama). Default auto skips when scoped.
# STUDY_COACH_ONYX_SKIP_SEARCH=auto
# STUDY_COACH_ONYX_SKIP_SEARCH=true
# STUDY_COACH_ONYX_SKIP_SEARCH=false
# Max chars of local curriculum injected into additional_context (default 12000 â‰ˆ one full doc)
# STUDY_COACH_ONYX_LOCAL_CURRICULUM_MAX_CHARS=12000
# Optional export dir fallback when SQLite full_doc is missing
# CURRICULUM_DOCS_EXPORT_DIR=C:\LittleCode\data\curriculum-docs-export
# Onyx server (.env on Docker host) â€” lower when subtopic filters are active:
# MAX_CHUNKS_FED_TO_CHAT=2
# num_ctx=8192
# --- Ollama Cloud (ollama.com API; tool-capable models, web search via native tools) ---
# Create key at https://ollama.com/settings/keys â€” store ONLY in .env.local (never commit).
# OLLAMA_API_KEY=your-ollama-api-key
# STUDY_COACH_USE_OLLAMA_CLOUD=true
# OLLAMA_CLOUD_ENABLED=true
# OLLAMA_CLOUD_BASE_URL=https://ollama.com
# Cloud chat model (no -cloud suffix when calling ollama.com directly; tool-capable e.g. qwen3-next:80b)
# STUDY_COACH_OLLAMA_CLOUD_MODEL=qwen3-next:80b
#
# Local Ollama chat completions (OpenAI-compatible); requires ollama serve on the host
# STUDY_COACH_OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
# STUDY_COACH_OLLAMA_MODEL=llama3.2:3b-gpu
# RTX 2060 (6 GB): llama3.2:3b-gpu-6g + STUDY_COACH_OLLAMA_NUM_CTX=8192 after configure-dual-gpu-ollama.ps1 -ApplyModelfile
# STUDY_COACH_OLLAMA_TIMEOUT_MS=120000
# STUDY_COACH_OLLAMA_NUM_CTX=4096
# STUDY_COACH_OLLAMA_MAX_HISTORY=4
# STUDY_COACH_OLLAMA_MAX_OUTPUT_TOKENS=256
# STUDY_COACH_OLLAMA_MAX_INPUT_TOKENS=
# STUDY_COACH_OLLAMA_INPUT_MARGIN=128
# STUDY_COACH_OLLAMA_KEEP_ALIVE=30m
# STUDY_COACH_OLLAMA_STREAM=true
# STUDY_COACH_OLLAMA_SKIP_DIAGRAMS=true
# Ollama server keep-alive (system/user env on the Windows host â€” NOT this .env file):
#   OLLAMA_KEEP_ALIVE=30m   keeps chat + embed models loaded after use (default is 5m)
# Set via Settings > Environment variables for your account, quit Ollama tray app, restart.
# Verify: .\scripts\check-ollama.ps1 -PreWarm
# STUDY_COACH_MODEL=gpt-4o-mini
# STUDY_COACH_MAX_OUTPUT_TOKENS=750
# Study Coach diagram image API model (separate from chat; defaults to STUDY_COACH_MODEL)
# OPENAI_DIAGRAM_MODEL=gpt-4o-mini
# Cache identical diagram prompts in SQLite (set false to always regenerate)
# DIAGRAM_IMAGE_CACHE=true
# STUDY_COACH_DIAGRAMS=true
# Max OpenAI image diagrams per coach reply (visual sequences allow up to 3 when enabled)
# STUDY_COACH_MAX_DIAGRAMS_PER_REPLY=1
# Hard stop for diagram + TTS work per reply (milliseconds)
# STUDY_COACH_MEDIA_BUDGET_MS=45000
# STUDY_COACH_MOCK=false
#
# Study Coach RAG â€” local curriculum reference chunks (NOT question bank embeddings)
# STUDY_COACH_RAG_ENABLED=true
# STUDY_COACH_RAG_TOP_K=1
# STUDY_COACH_RAG_MAX_CHARS=1600
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_EMBED_TIMEOUT_MS=60000
# CURRICULUM_DOC_MODEL=gpt-4.1-mini
# CURRICULUM_DOC_MAX_OUTPUT_TOKENS=1800
#
# Topic-focused study time required before quiz unlock (default 30 minutes)
# STUDY_UNLOCK_MIN_SECONDS=1800
# Minimum seconds credited per on-topic message; gaps capped separately
# STUDY_MIN_SECONDS_PER_ON_TOPIC_MESSAGE=45
# STUDY_MAX_GAP_SECONDS=300
# Global fallback; tier overrides below (per student per assignment â€” N children = N Ã— cap)
# STUDY_MAX_MESSAGES=60
# BILLING_FAMILY_STUDY_MAX_MESSAGES=45
# BILLING_SCHOOL_STUDY_MAX_MESSAGES=40
# Study Coach narration (off by default Ã¢â‚¬â€ zero API cost)
# Browser Web Speech + narration controls in the walkthrough UI (default off):
# STUDY_COACH_NARRATION_ENABLED=true
# Client bundle alias (set automatically from STUDY_COACH_NARRATION_ENABLED in next.config.mjs):
# NEXT_PUBLIC_STUDY_COACH_NARRATION_ENABLED=true
# Paid OpenAI TTS (pre-generated MP3 per step; legacy alias STUDY_COACH_NARRATION=true):
# STUDY_COACH_TTS_ENABLED=false  # keep paid TTS off (family economics)
# STUDY_COACH_TTS_MODEL=tts-1
# Professional voices: alloy (default), nova, onyx. Avoid cartoonish delivery in prompts.
# STUDY_COACH_TTS_VOICE=alloy
# Slightly slower narration for clarity (0.25Ã¢â‚¬â€œ4.0, default 0.95)
# STUDY_COACH_TTS_SPEED=0.95
# STUDY_COACH_MAX_NARRATION_PER_REPLY=6
# Study Coach microphone speech input in the Learn tab compose area (default on):
# STUDY_COACH_SPEECH_INPUT_ENABLED=true
# NEXT_PUBLIC_STUDY_COACH_SPEECH_INPUT_ENABLED=true
#
# Math-mode speech refinement via local embeddings (Transformers.js; zero API cost).
# First refine after server restart may take 5-15s while the model loads (CPU).
# STUDY_COACH_SPEECH_ML_REFINE=true
# STUDY_COACH_SPEECH_ML_MODEL=Xenova/all-MiniLM-L6-v2
